<Window x:Class="SampleAddin.HelloWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SampleAddin" Width="360" Height="180"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Hello from SampleAddin" />
        <TextBlock x:Name="DocumentText" Margin="0,8,0,0" />
        <TextBlock x:Name="AssemblyText" Margin="0,4,0,0" Foreground="Gray" />
        <Button Content="Close" Width="80" Margin="0,16,0,0" HorizontalAlignment="Right" IsCancel="True" />
    </StackPanel>
</Window>
