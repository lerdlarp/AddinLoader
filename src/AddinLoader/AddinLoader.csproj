<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build for a specific Revit version:
      dotnet build -c Release -p:RevitVersion=2024
    Revit 2020-2024 run on .NET Framework 4.8, 2025-2026 on .NET 8, and 2027 on .NET 10.
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>
    <TargetFramework Condition="$(RevitVersion) &lt; 2025">net48</TargetFramework>
    <TargetFramework Condition="$(RevitVersion) &gt;= 2025 and $(RevitVersion) &lt; 2027">net8.0-windows</TargetFramework>
    <TargetFramework Condition="$(RevitVersion) &gt;= 2027">net10.0-windows7.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>AddinLoader</RootNamespace>
    <AssemblyName>AddinLoader</AssemblyName>
    <Version>1.0.0</Version>
    <Description>Load, reload and run Revit add-ins without restarting Revit.</Description>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <OutputPath>bin\$(Configuration)\$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="$(RevitVersion).*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <!-- WPF is used from code only (no XAML), so a plain framework reference is enough. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="AddinLoader.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
